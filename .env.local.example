# انسخ هذا الملف إلى .env.local وضع القيم الحقيقية (لا ترفع .env.local على GitHub)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح service_role — سيرفر بس (بدون بادئة NEXT_PUBLIC_) عشان يفضل مخفي عن
# المتصفح. لازم لتبويب "إدارة العملاء" (إنشاء/حذف حساب، إعادة تعيين كلمة مرور،
# تفعيل/إيقاف). خده من: Supabase Dashboard → Project Settings → API → service_role.
# ⚠️ لا تحطه أبدًا في متغير بادئته NEXT_PUBLIC_ ولا تشاركه مع حد.
SUPABASE_SERVICE_ROLE_KEY=
