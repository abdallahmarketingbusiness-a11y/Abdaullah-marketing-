# انسخ هذا الملف إلى .env.local وضع القيم الحقيقية (لا ترفع .env.local على GitHub)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح service_role — سيرفر بس (بدون بادئة NEXT_PUBLIC_) عشان يفضل مخفي عن
# المتصفح. لازم لتبويب "إدارة العملاء" (إنشاء/حذف حساب، إعادة تعيين كلمة مرور،
# تفعيل/إيقاف). خده من: Supabase Dashboard → Project Settings → API → service_role.
# ⚠️ لا تحطه أبدًا في متغير بادئته NEXT_PUBLIC_ ولا تشاركه مع حد.
SUPABASE_SERVICE_ROLE_KEY=

# مفتاح OpenRouter — لازم عشان شات "خبير عبدالله ماركتنج" الذكي يشتغل. الشات
# بيستخدم 3 موديلات بالترتيب (Automatic Failover) — لو الأول فشل (Rate Limit/
# خطأ سيرفر/Timeout) بينتقل تلقائيًا للي بعده من غير أي تدخل:
#   1) deepseek/deepseek-chat-v3.1
#   2) qwen/qwen3-30b-a3b
#   3) google/gemini-2.5-flash
# خده من: https://openrouter.ai/keys
# سيرفر بس (بدون بادئة NEXT_PUBLIC_) عشان يفضل مخفي عن المتصفح.
OPENROUTER_API_KEY=
